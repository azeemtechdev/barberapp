# Supabase — from your project settings at supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack — from your Paystack dashboard (use test keys until you're ready to go live)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# Dev-only: set to "true" to skip Paystack entirely and auto-confirm bookings,
# so you can test the app before setting up payment keys. Remove/set to
# "false" before going live — this lets anyone "pay" with no real charge.
SKIP_PAYSTACK=true

# Your deployed URL — used to build the Paystack checkout callback link.
# Use http://localhost:3000 for local testing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
